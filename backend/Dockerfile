# ---------- Этап 1: сборка ----------
# Образ с компилятором Go (~250 МБ) нужен только для сборки,
# в финальный образ он не попадёт.
FROM golang:1.22-alpine AS builder

WORKDIR /build

# Сначала копируем только файлы зависимостей и скачиваем их.
# Этот слой кэшируется: пока go.mod/go.sum не менялись,
# при правке кода зависимости не скачиваются заново.
COPY go.mod go.sum ./
RUN go mod download

# Теперь копируем исходники и собираем бинарник.
# CGO_ENABLED=0 — статический бинарник без зависимости от glibc,
# поэтому он запустится в distroless/static.
# -ldflags="-s -w" убирает отладочную информацию — бинарник меньше.
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/app ./main.go

# ---------- Этап 2: исполнение ----------
# distroless/static: нет shell, нет пакетного менеджера, нет утилит.
# Даже если процесс взломают, запустить в контейнере шелл не получится.
FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /app

# Из первого этапа забираем только готовый бинарник
COPY --from=builder /out/app /app/app

# Явно запускаемся не от root. В образе :nonroot это уже
# пользователь по умолчанию (nonroot, UID 65532), строка — для наглядности.
USER 65532:65532

# Документация: приложение слушает 8080 (сам порт пробрасывает Compose)
EXPOSE 8080

# ENTRYPOINT фиксирует, какой бинарник запускать
ENTRYPOINT ["/app/app"]
